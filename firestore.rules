rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection - owner or admin can read; owner can create with role 'user'; owner can update if role field is unchanged; admin can read/write any user
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      allow update: if isAdmin() || (isOwner(userId) && request.resource.data.role == resource.data.role);
      allow delete: if isAdmin();
    }

    // Admin Logs collection - strictly admin
    match /admin_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Favorites collection - user can only read/write their own favorites
    match /favorites/{favoriteId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Push notification tokens collection
    match /fcm_tokens/{tokenId} {
      allow read, write: if isAuthenticated();
    }

    // Notifications collection - user can read own/global notifications; admin creates; user/admin can update or delete own
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'global');
      allow create: if isAdmin();
      allow update, delete: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
    }

    // Notification preferences collection
    match /notification_preferences/{prefId} {
      allow read, write: if isAuthenticated();
    }

    // News collection - public read, write strictly for admin
    match /news/{newsId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // News sync logs - public read, write strictly for admin
    match /news_sync_logs/{logId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Coupons collection - public read, write strictly for admin
    match /coupons/{couponId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Free Games collection - public read, write strictly for admin
    match /free_games/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /freeGames/{gameId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Deals / Promotions collection - public read, write strictly for admin
    match /deals/{dealId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default catch-all: deny unhandled collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
